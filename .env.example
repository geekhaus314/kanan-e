# Database
DATABASE_URL="postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/kananos?sslmode=require"

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend (transactional emails)
RESEND_API_KEY="re_..."

# Stripe (test keys)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Cloudflare R2 (file storage)
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET_NAME="kananos"
R2_ENDPOINT="https://...r2.cloudflarestorage.com"
R2_PUBLIC_URL="https://pub-...r2.dev"

# Meilisearch
MEILISEARCH_URL="http://localhost:7700"
MEILISEARCH_API_KEY="..."

# Upstash Redis
REDIS_URL="redis://..."

# Public
NEXT_PUBLIC_SITE_URL="https://kanan-e.vercel.app"

# ── Telegram Admin Bot ──────────────────────────────────────────
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=""
# Comma-separated Telegram user IDs allowed to use the bot
ADMIN_TELEGRAM_IDS=""
# Tenant slug the bot manages (default: united)
TENANT_SLUG="united"

# ── Admin Web Access ────────────────────────────────────────────
# Set to "true" to re-enable web admin panel (not recommended for production)
ADMIN_WEB_ENABLED="false"
